# Copie para .env e ajuste. NUNCA versione o .env.
DB_NAME=estoquefacil
DB_USER=estoque
DB_PASSWORD=troque-esta-senha
# Chave do JWT (mínimo 32 caracteres). Gere com: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-longo-com-pelo-menos-32-caracteres
# Validade do token (exemplos: 30m, 8h, 1d)
JWT_EXPIRATION=8h

# Primeiro administrador (criado só se não existir nenhum usuário)
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=troque-a-senha-do-admin